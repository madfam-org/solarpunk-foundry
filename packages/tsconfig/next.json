{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Solarpunk Next.js",
  "_comment": "A Next.js app: Next emits, TypeScript only checks. Set `include`, `baseUrl` and `paths` in your own tsconfig.json - see the note in base.json.",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  }
}
