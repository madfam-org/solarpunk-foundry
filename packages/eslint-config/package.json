    "directory": "packages/eslint-config"
  },
  "homepage": "https://github.com/madfam-org/solarpunk-foundry/tree/main/packages/eslint-config",
  "bugs": {
    "url": "https://github.com/madfam-org/solarpunk-foundry/issues"
  },
  "keywords": [
    "madfam",
    "eslint",
    "eslint-config",
    "config"
  ],
  "main": "index.cjs",
